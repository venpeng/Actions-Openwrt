# =============================================================
# 额外插件清单（ACRH17 / immortalwrt 21.02）
#
# 由 workflow 输入 extra_plugins 控制：
#   true  → 逐条写入 .config（=y）
#   false → 逐条写成 "# CONFIG_x is not set"
#
# 与 23.05/24.10 分支的差异：
#   - 21.02 是 firewall3 + iptables，UPnP 只有 miniupnpd 一种变体，
#     没有 miniupnpd-nftables
#   - 21.02 的 LuCI 是 Lua 版，helloworld 的 ssr-plus 不需要 luci-compat
#   - 代理内核 xray 由 helloworld feed 提供，替换掉 21.02 自带的
#     luci-app-ssr-plus(187) + xray-core(1.8.3)
#
# ⚠ 不在本列的常驻包（默认已选，固化在 base 配置）：
#     autocore-arm / automount / luci-app-cpufreq / luci-app-turboacc
#
# ⚠ 依赖包也列在这里（xray-core / chinadns-ng / ttyd / p910nd …）：
#   否则 extra_plugins=false 时「插件关了、依赖还编进固件」白占空间。
# =============================================================

## Extra packages
# Extra packages ---> autosamba    Samba 自动挂载（package/emortal，依赖 luci-app-samba4 + wsdd2）
CONFIG_PACKAGE_autosamba=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-libs=y

# Extra packages ---> ipv6helper   IPv6 助手（6in4 隧道更新 + LAN 侧 RA 寿命）
CONFIG_PACKAGE_ipv6helper=y

## 插件
# LuCI ---> Applications ---> luci-app-autoreboot   支持计划重启
CONFIG_PACKAGE_luci-app-autoreboot=y

# LuCI ---> Applications ---> luci-app-ddns        动态域名 DNS
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y

# LuCI ---> Applications ---> luci-app-ssr-plus   代理（helloworld feed）
# 版本由 workflow 下拉 hw_version 决定：25.1.1 / 24.12.31 / 1.8.24，
# 提交映射见 diysh/acrh17/diy-part1.sh。
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_chinadns-ng=y
# 256MB 内存：MosDNS 是第二个常驻 Go 进程（30~50MB），关掉；分流交给 chinadns-ng。
# 这行是「显式关闭」写法，gen-config.sh 认得。
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS is not set

# LuCI ---> Applications ---> luci-app-turboacc   软加速（21.02 里是默认包，这里仍列一份便于关闭）
CONFIG_PACKAGE_luci-app-turboacc=y

# LuCI ---> Applications ---> luci-app-ttyd        ttyd 终端
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# LuCI ---> Applications ---> luci-app-upnp        通用即插即用 UPnP
# 21.02 用 firewall3/iptables，只有 miniupnpd 一个包（没有 -nftables 变体）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y

# LuCI ---> Applications ---> luci-app-usb-printer USB 打印服务器
CONFIG_PACKAGE_luci-app-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_kmod-usb-printer=y

# LuCI ---> Applications ---> luci-app-wechatpush  微信推送
CONFIG_PACKAGE_luci-app-wechatpush=y

# LuCI ---> Applications ---> luci-app-wol        WOL 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y

## 插件增强
# Network ---> IP Addresses and Names ---> ddns-scripts-cloudflare
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
