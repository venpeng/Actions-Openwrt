# =============================================================
# immortalwrt 23.05 基础配置（种子）
#
# 这里只写「必须明确指定」的项，其余全部交给 `make defconfig` 展开。
#
# 为什么不像 24.10 分支那样放一份 7000 行的完整 .config：
#   1. 完整 .config 是 menuconfig 的产物，符号与版本强绑定。把 24.10 的
#      那份抄到 23.05，会有一批符号（内核模块、luci 组件、包名）对不上，
#      defconfig 静默丢弃，编出来少东西还看不出来。
#   2. immortalwrt 23.05 的默认包已经很全（include/target.mk）：
#        DEFAULT_PACKAGES.router → dnsmasq-full / firewall4 / nftables / ppp
#        DEFAULT_PACKAGES.tweak  → luci / luci-compat / luci-lib-ipkg /
#                                  luci-app-opkg / default-settings-chn
#      ipq40xx 的 target.mk 还会默认带：
#        kmod-ath10k-ct / wpad-openssl / ath10k-firmware-qca4019-ct /
#        autocore / automount / luci-app-cpufreq / uboot-envtools
#      → 代理要的 dnsmasq-full、Lua 界面要的 luci-compat 本来就是默认项。
#   3. 首次构建的产物里会附带展开后的完整 .config，确认没问题后可以把它
#      整份拷回来覆盖本文件（脚本带兜底清理，混进机型符号也不怕）。
# =============================================================

# ---- 目标平台 ----
# 机型符号（CONFIG_TARGET_ipq40xx_generic_DEVICE_asus_rt-ac42u）由
# scripts/ci/gen-config.sh 在 defconfig 前追加，这里不写。
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y

# ---- 中文界面 ----
# luci.mk 里是 config LUCI_LANG_zh_Hans，选上会把各 app 的 i18n 一并带上；
# base 的翻译包再显式写一份，保证首页菜单不是英文。
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---- LuCI 基础组件 ----
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
# 23.05 的 LuCI 前端是 JS，而 ssr-plus 是 Lua CBI，必须靠 luci-compat 渲染。
# 它本来就在 DEFAULT_PACKAGES.tweak 里，显式写一份是为了不依赖默认值。
CONFIG_PACKAGE_luci-compat=y

# ---- 代理依赖的前置项（写成显式的一行，防止将来默认值变动）----
# 23.05 默认就是 dnsmasq-full，但 ssr-plus 依赖它的 ipset/nftset 能力，
# 一旦回落到 dnsmasq 会在 defconfig 阶段报冲突。
CONFIG_PACKAGE_dnsmasq-full=y

# ---- 常用命令行工具（不占多少空间，刷完少折腾）----
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
